# Database
DATABASE_URL="postgresql://user:password@localhost:5432/manufacturing?schema=public"

# 認証用パスワード/PINのbcryptハッシュ値
# 生成方法: npm run auth:hash -- "your-password"
APP_PASSWORD_HASH=""

# Cookie署名キー（32文字以上のランダム値）
# 生成方法: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# セッション有効期限（日数。任意、デフォルト 7）
SESSION_MAX_AGE_DAYS=7

# ─── 楽天RMS API 認証情報 ────────────────────────────────────────────────────
# RMS管理画面 > システム設定 > API認証設定 で確認
RAKUTEN_SERVICE_SECRET=""
RAKUTEN_LICENSE_KEY=""
