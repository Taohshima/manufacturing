# Database
DATABASE_URL="postgresql://user:password@localhost:5432/manufacturing?schema=public"

# 認証用パスワード/PINのbcryptハッシュ値
# 生成方法: npm run auth:hash -- "your-password"
APP_PASSWORD_HASH=""

# Cookie署名キー（32文字以上のランダム値）
# 生成方法: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# セッション有効期限（日数。任意、デフォルト 7）
SESSION_MAX_AGE_DAYS=7

# ---------------------------------------------------------------------------
# Rakuten RMS API（scripts/rakuten_rms_extract.py 用）
# ---------------------------------------------------------------------------
# RMS > システム・自動化設定 > RMS API でサービスシークレット・ライセンスキーを取得
RAKUTEN_SERVICE_SECRET=""
RAKUTEN_LICENSE_KEY=""

# アクセス分析CSVのパス（任意）
# RMS > アクセス分析 > 商品別アクセス分析 > 日別 > CSVダウンロード で取得したファイル
RAKUTEN_ACCESS_CSV=""

# 集計対象日（任意。省略時は昨日）例: 2026-06-10
RAKUTEN_TARGET_DATE=""

# 出力ディレクトリ（任意。デフォルト: data/rakuten）
RAKUTEN_OUTPUT_DIR="data/rakuten"
